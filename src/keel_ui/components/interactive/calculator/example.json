{
  "title": "Position size calculator",
  "intro": "Set your risk and stop, and see the exact lot size that keeps the loss within budget.",
  "inputs": [
    { "key": "account", "label": "Account balance", "type": "number", "prefix": "$", "default": 5000, "min": 0 },
    { "key": "riskPct", "label": "Risk per trade", "type": "slider", "unit": "%", "min": 0.1, "max": 5, "step": 0.1, "default": 1 },
    { "key": "stopPips", "label": "Stop-loss", "type": "number", "unit": "pips", "default": 20, "min": 1 },
    { "key": "pipValue", "label": "Pip value per lot", "type": "number", "prefix": "$", "default": 10, "min": 0.01 }
  ],
  "outputs": [
    { "label": "Risk amount", "expr": "account*riskPct/100", "format": "currency" },
    { "label": "Position size", "expr": "account*riskPct/100/(stopPips*pipValue)", "format": "number", "decimals": 2, "suffix": " lots", "featured": true }
  ]
}
