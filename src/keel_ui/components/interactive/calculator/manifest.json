{
  "id": "calculator",
  "name": "Interactive Calculator",
  "category": "interactive",
  "version": 1,
  "when_to_pick": "ANY time the reader should plug in their own numbers and watch a result update live — position size, pip value, payout, break-even, expectancy, compounding, risk-of-ruin, spread cost, drawdown, leverage, anything. This is the ONE calculator component: you declare the inputs (number / slider / stepper / segmented / toggle), the output formulas (plain arithmetic over the input keys, with min/max/abs/round/clamp/sqrt/pow available), and how each result is formatted. The component builds the calculator for THAT specific need. Do not look for a pre-made calculator per topic — there is exactly one, and you shape it.",
  "tags": ["calculator", "interactive", "what-if", "builder"],
  "audience_fit": ["forex", "crypto", "binary", "stocks", "prop-firm", "beginner", "pro"],
  "dependencies": [],
  "schema": {
    "type": "object",
    "required": ["inputs", "outputs"],
    "properties": {
      "title": { "type": "string", "maxLength": 90 },
      "intro": { "type": "string", "maxLength": 240 },
      "inputs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "required": ["key", "label", "type"],
          "properties": {
            "key": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$", "maxLength": 24 },
            "label": { "type": "string", "maxLength": 48 },
            "type": { "type": "string", "enum": ["number", "slider", "stepper", "segmented", "toggle"] },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 },
            "default": { "type": "number" },
            "unit": { "type": "string", "maxLength": 10 },
            "prefix": { "type": "string", "maxLength": 4 },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": ["label", "value"],
                "properties": {
                  "label": { "type": "string", "maxLength": 18 },
                  "value": { "type": "number" }
                }
              }
            },
            "on_value": { "type": "number" },
            "off_value": { "type": "number" }
          }
        }
      },
      "outputs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "required": ["label", "expr"],
          "properties": {
            "label": { "type": "string", "maxLength": 40 },
            "expr": { "type": "string", "maxLength": 240 },
            "format": { "type": "string", "enum": ["number", "currency", "percent", "ratio"] },
            "decimals": { "type": "integer", "minimum": 0, "maximum": 4 },
            "prefix": { "type": "string", "maxLength": 4 },
            "suffix": { "type": "string", "maxLength": 12 },
            "featured": { "type": "boolean" },
            "sign_color": { "type": "boolean" }
          }
        }
      }
    }
  }
}
