{
  "id": "chart_radar",
  "name": "Radar Chart",
  "category": "compare",
  "pack": "core",
  "version": 1,
  "when_to_pick": "Compare 2-4 candidates across 4-8 dimensions on the same 0-100 scale — bot scoring across latency / cost / customizability / win rate / drawdown / ease-of-use. Best when each axis is normalized to the same unit.",
  "tags": ["chart", "multi-axis", "comparison"],
  "audience_fit": ["forex", "crypto", "prop-firm"],
  "dependencies": ["chartjs"],
  "schema": {
    "type": "object",
    "required": ["title", "axes", "candidates"],
    "properties": {
      "title":     { "type": "string", "maxLength": 120 },
      "caption":   { "type": "string", "maxLength": 240 },
      "max_value": { "type": "number", "minimum": 1, "default": 100 },
      "axes":      { "type": "array", "minItems": 4, "maxItems": 8, "items": { "type": "string" } },
      "candidates": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "required": ["label", "data"],
          "properties": {
            "label": { "type": "string", "maxLength": 60 },
            "data":  { "type": "array", "items": { "type": "number" } },
            "tone":  { "type": "string", "enum": ["accent", "success", "danger", "warning", "purple", "neutral"], "default": "accent" }
          }
        }
      }
    }
  }
}
